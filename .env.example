# ============================================================
# NEBULA NODE — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and should NEVER be committed.
# ============================================================

# ─── Authentication (override demo defaults in config.ts) ────
# NEBULA_WORD_KEY="your secure word key here"
# NEBULA_PASSKEY="your secure passkey here"

# ─── Ollama (optional — app works without it) ────────────────
# VITE_OLLAMA_BASE_URL=http://localhost:11434

# ─── Telegram Alerts (optional) ──────────────────────────────
# NEBULA_TELEGRAM_TOKEN=your_bot_token_here
# NEBULA_TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Pushover Alerts (optional) ──────────────────────────────
# NEBULA_PUSHOVER_TOKEN=your_app_token_here
# NEBULA_PUSHOVER_USER_KEY=your_user_key_here
